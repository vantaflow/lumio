{
  "$description": "Jetons de design Lumio. Source pour app/lib/ui/theme.dart. Unités : dp logiques (TV : canevas logique 1920x1080, voir README).",
  "color": {
    "dark": {
      "bg": "#0E1116",
      "bgAlt": "#12171E",
      "surface": "#161B22",
      "surfaceRaised": "#1F2630",
      "surfaceFocus": "#2A3340",
      "outline": "#3A4452",
      "text": "#F3F5F7",
      "textMuted": "#A9B2BF",
      "accent": "#FFB84D",
      "onAccent": "#1A1100",
      "secondary": "#4FD1C5",
      "focusRing": "#FFE08A",
      "success": "#5BD68A",
      "warning": "#FFB84D",
      "error": "#FF7A70"
    },
    "light": {
      "bg": "#F7F5F0",
      "bgAlt": "#EFECE4",
      "surface": "#FFFFFF",
      "surfaceRaised": "#F1EEE7",
      "surfaceFocus": "#E4E0D5",
      "outline": "#B9B3A4",
      "text": "#14171C",
      "textMuted": "#4A5361",
      "accent": "#A85500",
      "onAccent": "#FFFFFF",
      "secondary": "#00796B",
      "focusRing": "#0B57D0",
      "success": "#1B7F44",
      "warning": "#8A5A00",
      "error": "#B3261E"
    },
    "poster": ["#2E6F7A", "#8A5A2B", "#7A3B2E", "#C98A3D", "#1F4A55", "#3C8F7A"]
  },
  "typography": {
    "fontDisplay": "Bricolage Grotesque",
    "fontBody": "Manrope",
    "tv": {
      "display": { "size": 72, "weight": 700, "lineHeight": 1.05, "family": "display" },
      "h1": { "size": 64, "weight": 700, "lineHeight": 1.1, "family": "display" },
      "h2": { "size": 44, "weight": 700, "lineHeight": 1.15, "family": "display" },
      "title": { "size": 34, "weight": 700, "lineHeight": 1.2, "family": "display" },
      "body": { "size": 30, "weight": 600, "lineHeight": 1.35, "family": "body" },
      "label": { "size": 28, "weight": 600, "lineHeight": 1.3, "family": "body" },
      "caption": { "size": 24, "weight": 600, "lineHeight": 1.3, "family": "body" }
    },
    "phone": {
      "display": { "size": 32, "weight": 700, "lineHeight": 1.15, "family": "display" },
      "h1": { "size": 28, "weight": 700, "lineHeight": 1.15, "family": "display" },
      "h2": { "size": 20, "weight": 700, "lineHeight": 1.2, "family": "display" },
      "title": { "size": 18, "weight": 700, "lineHeight": 1.25, "family": "display" },
      "body": { "size": 16, "weight": 400, "lineHeight": 1.4, "family": "body" },
      "label": { "size": 14, "weight": 600, "lineHeight": 1.3, "family": "body" },
      "caption": { "size": 12, "weight": 600, "lineHeight": 1.3, "family": "body" }
    },
    "desktop": { "$ref": "phone", "scale": 1.0, "note": "Même échelle que le téléphone, titres h1 à 38." }
  },
  "spacing": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 40, "xxl": 64, "tvMargin": 96 },
  "radius": { "sm": 10, "md": 16, "lg": 24, "xl": 32, "pill": 999 },
  "focusRing": {
    "width": 4,
    "offset": 4,
    "color": "focusRing",
    "scale": 1.06,
    "scaleRowCard": 1.08,
    "note": "Anneau à l'extérieur, jamais coupé : prévoir 12 dp de marge autour des rangées."
  },
  "size": {
    "tvCardPoster": { "w": 300, "h": 170 },
    "tvCardPortrait": { "w": 230, "h": 340 },
    "tvButtonHeight": 88,
    "tvRowHeight": 96,
    "phoneTouchMin": 48,
    "minTextTv": 24,
    "minTextPhone": 12
  },
  "motion": {
    "focus": { "ms": 120, "curve": "easeOut" },
    "scaleCard": { "ms": 160, "curve": "easeOutCubic" },
    "panel": { "ms": 220, "curve": "easeInOutCubic" },
    "screen": { "ms": 280, "curve": "easeInOutCubic" },
    "controlsHide": { "ms": 4000, "note": "masquage des commandes du lecteur sans action" },
    "reducedMotion": "toutes durées à 0 ms, pas de mise à l'échelle"
  }
}
