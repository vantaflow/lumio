{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumio-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // L'identifiant KV ci-dessous est un substitut : à remplacer au déploiement
  // (wrangler kv namespace create RATE). Les tests locaux utilisent Miniflare.
  "kv_namespaces": [
    { "binding": "RATE", "id": "00000000000000000000000000000000" }
  ],
  // Watch-party : une salle = un Durable Object (SQLite non utilisé, simple stockage KV du DO).
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1-rooms", "new_classes": ["Room"] }]
}
